# leanctx "Layer 8" sidecar — ClawRouter-tuned configuration.
# Copy to .env (compose reads it automatically):
#   cp integrations/clawrouter/.env.example integrations/clawrouter/.env
#
# Every knob below is optional — the image already ships these as defaults.

# on = compress; off = passthrough smoke test (no model load)
LEANCTX_SERVER_MODE=on

# Don't compress turns below this many tokens (protects short system / instruction turns).
LEANCTX_SERVER_THRESHOLD=1500

# Fraction of prose tokens to KEEP (lower = more aggressive). 0.5 ≈ ~50% savings on prose.
LEANCTX_SERVER_LINGUA_RATIO=0.5

# cpu | cuda | mps | (empty = auto). The GPU image overrides this to cuda.
LEANCTX_SERVER_LINGUA_DEVICE=cpu

# Leave off when fronted by ClawRouter — its Layer 1 already deduplicates.
LEANCTX_SERVER_DEDUP=off

# Advanced: a full JSON Middleware config wins over everything above.
# LEANCTX_SERVER_CONFIG={"mode":"on","trigger":{"threshold_tokens":1500},"routing":{"prose":"lingua"},"lingua":{"ratio":0.5,"device":"cuda"}}
